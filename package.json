{
  "name": "qa-framework",
  "version": "1.0.0",
  "description": "Playwright and TypeScript framework for UI, API, contract, accessibility, and visual testing",
  "scripts": {
    "prepare": "husky",
    "test:setup": "playwright install chromium",
    "test": "playwright test",
    "test:contract": "playwright test --project=contract",
    "test:ui": "playwright test --project=ui-chromium",
    "test:api": "playwright test --project=api",
    "test:a11y": "playwright test --project=ui-a11y",
    "test:visual": "playwright test --project=ui-visual",
    "test:smoke:contract": "playwright test --project=contract --grep @smoke",
    "test:smoke:ui": "playwright test --project=ui-chromium --grep @smoke",
    "test:smoke:api": "playwright test --project=api --grep @smoke",
    "test:smoke:a11y": "playwright test --project=ui-a11y --grep @smoke",
    "test:smoke": "npm run test:smoke:contract && npm run test:smoke:a11y && npm run test:smoke:ui",
    "test:smoke:all": "npm run test:smoke && npm run test:smoke:api",
    "lint": "eslint .",
    "format": "prettier --write .",
    "conduit:up": "docker compose -f docker-compose.conduit.yml up -d --build --wait",
    "conduit:down": "docker compose -f docker-compose.conduit.yml down -v",
    "conduit:wait": "bash scripts/conduit-wait.sh",
    "test:conduit:api": "playwright test --project=conduit-api",
    "test:conduit:ui": "playwright test --project=conduit-ui",
    "test:tags:conduit": "playwright test --grep @conduit",
    "test:tags:security": "playwright test --grep @security",
    "test:conduit:demo:smoke": "playwright test --project=conduit-api --project=conduit-ui --grep @smoke",
    "test:conduit:smoke": "npm run conduit:up && CONDUIT_API_URL=http://127.0.0.1:3000/api CONDUIT_UI_URL=http://127.0.0.1:4201 playwright test --project=conduit-api --project=conduit-ui --grep @smoke",
    "test:conduit": "npm run conduit:up && CONDUIT_API_URL=http://127.0.0.1:3000/api CONDUIT_UI_URL=http://127.0.0.1:4201 playwright test --project=conduit-api --project=conduit-ui && playwright test tests/contract/conduit/ --project=contract",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report",
    "allure:report": "npm run allure:generate && npm run allure:open"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@eslint/js": "^10.0.1",
    "@faker-js/faker": "^10.4.0",
    "@playwright/test": "^1.59.1",
    "@types/node": "^25.6.0",
    "allure-commandline": "^2.42.0",
    "allure-playwright": "^3.9.0",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.5",
    "playwright-qase-reporter": "^2.5.2",
    "prettier": "^3.8.3",
    "typescript-eslint": "^8.59.3"
  },
  "lint-staged": {
    "*.{ts,js}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "zod": "^4.4.3"
  }
}
