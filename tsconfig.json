{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "types": ["node", "@playwright/test"],
    "paths": {
      "@api/*": ["./api/*"],
      "@config/*": ["./config/*"],
      "@factories/*": ["./factories/*"],
      "@stub-servers/*": ["./stub-servers/*"],
      "@utils/*": ["./utils/*"],
      "@pages/*": ["./tests/pages/*"],
      "@fixtures/*": ["./tests/fixtures/*"]
    }
  }
}
