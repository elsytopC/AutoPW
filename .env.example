# Optional for first run — defaults in config/env.ts work without this file.
# Copy when you need live API (API_BASE_URL), PROD_AUTH, or custom Conduit URLs:
#   cp .env.example .env
#
# Todo UI and Users API
BASE_URL=https://demo.playwright.dev
API_BASE_URL=

# Set to true only when API_BASE_URL supports /login and real credentials exist.
PROD_AUTH=false
ADMIN_EMAIL=
ADMIN_PASSWORD=
USER_EMAIL=
USER_PASSWORD=

# RealWorld (Conduit)
# Public demo (default when Docker stack is not running):
CONDUIT_UI_URL=https://demo.realworld.show
CONDUIT_API_URL=https://api.realworld.show/api

# Local Docker stack (`npm run conduit:up`):
# CONDUIT_UI_URL=http://127.0.0.1:4201
# CONDUIT_API_URL=http://127.0.0.1:3000/api

# Qase reporting is disabled unless explicitly enabled.
QASE_MODE=off
QASE_TESTOPS_API_TOKEN=
